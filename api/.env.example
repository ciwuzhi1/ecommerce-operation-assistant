DATABASE_URL=mysql+pymysql://root:replace_with_random_urlsafe_32_char_secret@127.0.0.1:3306/ecommerce_operation
APP_ENV=development
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
REDIS_URL=redis://:replace_with_random_urlsafe_32_char_secret@127.0.0.1:6379/0
TASK_QUEUE_BACKEND=inline
CELERY_TASK_DEFAULT_QUEUE=generation
CELERY_AGENT_QUEUE=agent
CELERY_AGENT_WORKFLOW_QUEUE=agent.workflow
CELERY_MAINTENANCE_QUEUE=maintenance
AGENT_CHECKPOINT_DATABASE_URL=
AGENT_CHECKPOINT_HOST=127.0.0.1
AGENT_CHECKPOINT_PORT=5433
AGENT_CHECKPOINT_USER=agent
AGENT_CHECKPOINT_PASSWORD=local-agent@checkpoint
AGENT_CHECKPOINT_DATABASE=agent_checkpoints
AGENT_MAX_TOTAL_TOKENS=12000
AGENT_MAX_REVISIONS=1
OTEL_SERVICE_NAME=ecommerce-operation-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
AUTH_SECRET_KEY=dev-auth-secret-change-me
AUTH_TOKEN_EXPIRE_MINUTES=10080

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro

IMAGE_PROVIDER=jimeng
IMAGE_BASE_URL=https://visual.volcengineapi.com
# 即梦使用 AK:SK 组合，冒号分隔
IMAGE_API_KEY=
IMAGE_MODEL=jimeng_t2i_v30
IMAGE_SIZE=1024*1024
IMAGE_WORKSPACE_ID=
IMAGE_POLL_INTERVAL_SECONDS=5
IMAGE_POLL_MAX_ATTEMPTS=24

VIDEO_PROVIDER=jimeng
VIDEO_BASE_URL=https://visual.volcengineapi.com
VIDEO_API_KEY=
VIDEO_MODEL=jimeng_t2v_v30
VIDEO_SIZE=1280*720
# 帧数按 24*秒+1 计算，仅 5 秒与 10 秒为合法时长
VIDEO_DURATION=5
VIDEO_WORKSPACE_ID=
VIDEO_POLL_INTERVAL_SECONDS=10
VIDEO_POLL_MAX_ATTEMPTS=36
